diff -ruN a/legacy-php-app/src/Matcher.php b/legacy-php-app/src/Matcher.php
--- a/legacy-php-app/src/Matcher.php
+++ b/legacy-php-app/src/Matcher.php
@@ -3,10 +3,17 @@
 
 class Matcher
 {
-    // Silent semantic change: in PHP 7.4, 0 == "abc" is true. In PHP 8.0 it is false.
-    // No crash, no warning: only a test notices.
+    /**
+     * PHP 8.0 changed string-to-number comparison: `'abc' == 0` was true on
+     * PHP 7.4 and is false from PHP 8.0 on. The leading-numeric cast is made
+     * explicit here so the documented behaviour is preserved on PHP 8.5.
+     */
     public function isZeroLike($value)
     {
+        if (is_string($value) && !is_numeric($value)) {
+            return (int) $value === 0;
+        }
+
         return $value == 0;
     }
 }
diff -ruN a/legacy-php-app/src/Notes.php b/legacy-php-app/src/Notes.php
--- a/legacy-php-app/src/Notes.php
+++ b/legacy-php-app/src/Notes.php
@@ -1,24 +1,26 @@
 <?php
 namespace App;
 
+#[\AllowDynamicProperties]
 class Notes
 {
-    // Deprecated in PHP 8.4: implicitly nullable parameter type.
-    public function title(string $text = null)
+    // Explicitly nullable parameter type (implicit nullability deprecated in PHP 8.4).
+    public function title(?string $text = null)
     {
         return strtoupper(trim($text === null ? 'untitled' : $text));
     }
 
-    // Deprecated in PHP 8.2: creation of dynamic properties.
+    // Dynamic property creation is deprecated since PHP 8.2; the class opts in
+    // explicitly via #[\AllowDynamicProperties] so the public behaviour is kept.
     public function tag($name)
     {
         $this->{$name} = true;
         return $this;
     }
 
-    // Deprecated in PHP 8.2: "${var}" string interpolation.
+    // "{$var}" interpolation ("${var}" deprecated in PHP 8.2).
     public function greet($user)
     {
-        return "Hello ${user}";
+        return "Hello {$user}";
     }
 }
diff -ruN a/legacy-php-app/src/Sorter.php b/legacy-php-app/src/Sorter.php
--- a/legacy-php-app/src/Sorter.php
+++ b/legacy-php-app/src/Sorter.php
@@ -3,10 +3,12 @@
 
 class Sorter
 {
-    // create_function() was removed in PHP 8.0.
+    // create_function() was removed in PHP 8.0; a closure is the replacement.
     public function byName(array $names)
     {
-        $cmp = create_function('$a, $b', 'return strcmp($a, $b);');
+        $cmp = static function ($a, $b) {
+            return strcmp($a, $b);
+        };
         usort($names, $cmp);
         return $names;
     }
